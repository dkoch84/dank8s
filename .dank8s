function service { _resource_menu service "$@"; }
function ingress { _resource_menu ingress "$@"; }
function endpoint { _resource_menu endpoint "$@"; }
function configmap { _resource_menu configmap "$@"; }
function secret { _resource_menu secret "$@"; }
function certificate { _resource_menu certificate "$@"; }
