#!/bin/bash

#===============================================================================
# DANK8S - Kubernetes CLI Helpers
#===============================================================================

#-------------------------------------------------------------------------------
# Configuration
#-------------------------------------------------------------------------------

# Cache configuration
_KUBE_CACHE_DIR="/tmp/.dank8s-cache-$$"
_KUBE_CACHE_TTL=60  # seconds

# Resource action configurations
declare -gA _KUBE_RESOURCE_ACTIONS=(
  [pod]="Nothing Describe YAML Edit Delete"
  [deployment]="Nothing Describe YAML Edit Delete Restart"
  [service]="Nothing Describe YAML Edit Delete"
  [ingress]="Nothing Describe YAML Edit Delete"
  [endpoint]="Nothing Describe YAML Edit Delete"
  [configmap]="Nothing Describe YAML Edit Delete Recreate"
  [secret]="Nothing Decode Delete Recreate"
  [certificate]="Nothing Describe YAML Delete"
  [issuer]="Nothing Describe YAML Edit Delete"
  [order]="Nothing Describe YAML Edit Delete"
  [daemonset]="Nothing Describe YAML Edit Delete Restart"
  [statefulset]="Nothing Describe YAML Edit Delete Restart"
  [job]="Nothing Describe YAML Delete Logs"
  [cronjob]="Nothing Describe YAML Edit Delete Suspend Resume Trigger"
  [replicaset]="Nothing Describe YAML Delete"
  [persistentvolumeclaim]="Nothing Describe YAML Edit Delete"
  [persistentvolume]="Nothing Describe YAML Edit Delete"
  [storageclass]="Nothing Describe YAML Edit Delete"
  [networkpolicy]="Nothing Describe YAML Edit Delete"
  [serviceaccount]="Nothing Describe YAML Edit Delete"
  [namespace]="Nothing Describe YAML Edit Delete"
  [node]="Nothing Describe"
  [logs]="Nothing Follow Pager"
)

# Watch command mappings
declare -gA _KUBE_WATCH_COMMANDS=(
  [pods]="kubectl get pods \$KUBEALL --force-colors"
  [deployments]="kubectl get deployments \$KUBEALL --force-colors"
  [services]="kubectl get services \$KUBEALL --force-colors"
  [nodes]="kubectl get nodes --force-colors"
  [events]="kubectl get events \$KUBEALL --sort-by=.metadata.creationTimestamp --force-colors"
  [ingresses]="kubectl get ingresses \$KUBEALL --force-colors"
  [endpoints]="kubectl get endpoints \$KUBEALL --force-colors"
  [configmaps]="kubectl get configmaps \$KUBEALL --force-colors"
  [secrets]="kubectl get secrets \$KUBEALL --force-colors"
  [certificates]="kubectl get certificates \$KUBEALL --force-colors"
  [issuers]="kubectl get issuers \$KUBEALL --force-colors"
  [orders]="kubectl get orders \$KUBEALL --force-colors"
  [daemonsets]="kubectl get daemonsets \$KUBEALL --force-colors"
  [ds]="kubectl get daemonsets \$KUBEALL --force-colors"
  [statefulsets]="kubectl get statefulsets \$KUBEALL --force-colors"
  [sts]="kubectl get statefulsets \$KUBEALL --force-colors"
  [jobs]="kubectl get jobs \$KUBEALL --force-colors"
  [cronjobs]="kubectl get cronjobs \$KUBEALL --force-colors"
  [cjs]="kubectl get cronjobs \$KUBEALL --force-colors"
  [replicasets]="kubectl get replicasets \$KUBEALL --force-colors"
  [rs]="kubectl get replicasets \$KUBEALL --force-colors"
  [persistentvolumeclaims]="kubectl get persistentvolumeclaims \$KUBEALL --force-colors"
  [pvcs]="kubectl get persistentvolumeclaims \$KUBEALL --force-colors"
  [persistentvolumes]="kubectl get persistentvolumes --force-colors"
  [pvs]="kubectl get persistentvolumes --force-colors"
  [storageclasses]="kubectl get storageclasses --force-colors"
  [sc]="kubectl get storageclasses --force-colors"
  [networkpolicies]="kubectl get networkpolicies \$KUBEALL --force-colors"
  [netpols]="kubectl get networkpolicies \$KUBEALL --force-colors"
  [serviceaccounts]="kubectl get serviceaccounts \$KUBEALL --force-colors"
  [sas]="kubectl get serviceaccounts \$KUBEALL --force-colors"
  [namespaces]="kubectl get namespaces --force-colors"
  [nss]="kubectl get namespaces --force-colors"
)

# Cluster-scoped resources (no namespace)
declare -gA _KUBE_CLUSTER_SCOPED=(
  [node]=1 [persistentvolume]=1 [storageclass]=1 [namespace]=1
)

# Pluralization map
declare -gA _KUBE_PLURALS=(
  [ingress]="ingresses" [endpoint]="endpoints" [configmap]="configmaps"
  [secret]="secrets" [pod]="pods" [deployment]="deployments"
  [service]="services" [node]="nodes" [certificate]="certificates"
  [issuer]="issuers" [order]="orders" [daemonset]="daemonsets"
  [statefulset]="statefulsets" [job]="jobs" [cronjob]="cronjobs"
  [replicaset]="replicasets" [persistentvolumeclaim]="persistentvolumeclaims"
  [persistentvolume]="persistentvolumes" [storageclass]="storageclasses"
  [networkpolicy]="networkpolicies" [serviceaccount]="serviceaccounts"
  [namespace]="namespaces"
)

# All dank8s functions for cleanup
_KUBE_FUNCTIONS="kubehelp unkube kubeall pluralize_resource ns refresh khelper watch exec rollout logs
  pods deployments services nodes events ingresses endpoints configmaps secrets
  certificates issuers orders daemonsets statefulsets jobs cronjobs replicasets
  persistentvolumeclaims persistentvolumes storageclasses networkpolicies serviceaccounts namespaces
  deps svcs ings eps cms certs ds sts cjs rs pvcs pvs sc netpols sas nss
  pod deployment service node ingress endpoint configmap secret certificate issuer order
  daemonset statefulset job cronjob replicaset persistentvolumeclaim persistentvolume
  storageclass networkpolicy serviceaccount namespace
  dep svc ing ep cm cert cj pvc pv netpol sa
  ctx ctxs context cluster install-nginx
  _resource_menu _confirm_delete _kube_require_resource _kube_cached_get _kube_clear_cache"

#-------------------------------------------------------------------------------
# Help
#-------------------------------------------------------------------------------

function kubehelp {
  BOLD="$(tput bold)"
  BLUE="$(tput setaf 4)"
  NC="$(tput sgr0)"
  cat <<EOF
${BOLD}Dank Kubernetes Helpers${NC}

${BLUE}Context${NC}
  ctx [name]                  Show current context or switch
  ctxs                        List all contexts
  context                     Interactive context menu
  cluster                     Show cluster info

${BLUE}Setup${NC}
  ns <namespace>              Set kubectl namespace
  kubeall on|off              Toggle all-namespaces mode

${BLUE}List Resources${NC}
  pods|deployments|services|nodes|events|ingresses|endpoints
  configmaps|secrets|certificates|issuers|orders|daemonsets
  statefulsets|jobs|cronjobs|replicasets|pvcs|pvs|storageclasses
  networkpolicies|serviceaccounts|namespaces

  Shortcuts: deps|svcs|ings|eps|cms|certs|ds|sts|cjs|rs,
            netpols|sas|nss|sc

${BLUE}Inspect Resources${NC}
  pod|deployment|service|node|ingress|endpoint|configmap|secret
  certificate|issuer|order|daemonset|statefulset|job|cronjob
  replicaset|pvc|pv|storageclass|networkpolicy|serviceaccount|namespace

  Usage: <type> <name>  (auto-detects namespace|shows interactive menu)
  Shortcuts: dep|svc|ing|ep|cm|cert|ds|sts|cj|rs|netpol|sa

${BLUE}Actions${NC}
  exec <pod>                  Open shell in pod
  rollout <deployment>        Restart deployment
  logs <pod>                  View pod logs
  watch <resource|command>    Auto-refresh view (press 'q' to quit)

${BLUE}Utilities${NC}
  refresh <command>           Clear screen and run command
  kubehelp                    Show this help
  unkube                      Remove all helpers
EOF
}

#-------------------------------------------------------------------------------
# Caching
#-------------------------------------------------------------------------------

function _kube_cached_get {
  local cache_key="$1"
  local cmd="$2"
  local cache_file="$_KUBE_CACHE_DIR/$cache_key"

  mkdir -p "$_KUBE_CACHE_DIR" 2>/dev/null

  # Check if cache exists and is fresh
  if [[ -f "$cache_file" ]]; then
    local age=$(($(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0)))
    if [[ $age -lt $_KUBE_CACHE_TTL ]]; then
      cat "$cache_file"
      return 0
    fi
  fi

  # Fetch and cache
  local result
  result=$(eval "$cmd" 2>/dev/null)
  echo "$result" > "$cache_file"
  echo "$result"
}

function _kube_clear_cache {
  rm -rf "$_KUBE_CACHE_DIR" 2>/dev/null
  mkdir -p "$_KUBE_CACHE_DIR" 2>/dev/null
}

#-------------------------------------------------------------------------------
# Error Handling
#-------------------------------------------------------------------------------

function _kube_require_resource {
  local resource_type="$1"
  local name="$2"
  local namespace="$3"

  if [[ -z "$name" ]]; then
    echo "Usage: $resource_type <name>" >&2
    return 1
  fi

  if [[ -z "$namespace" && -z "${_KUBE_CLUSTER_SCOPED[$resource_type]}" ]]; then
    echo "Error: Could not find ${resource_type} '${name}'" >&2
    return 1
  fi
  return 0
}

function _confirm_delete {
  local resource_type="$1"
  local name="$2"
  local namespace="$3"
  local extra_warning="$4"

  local prompt="Are you sure you want to delete ${resource_type} ${name}"
  if [[ -n "$namespace" ]]; then
    prompt+=" in namespace ${namespace}"
  fi
  if [[ -n "$extra_warning" ]]; then
    prompt+="? ${extra_warning}"
  else
    prompt+="?"
  fi
  prompt+=" (yes/no)"

  echo "$prompt"
  read confirm
  [[ "$confirm" == "yes" ]]
}

#-------------------------------------------------------------------------------
# Context Management
#-------------------------------------------------------------------------------

function ctx {
  if [[ -z "$1" ]]; then
    kubectl config current-context
  else
    kubectl config use-context "$1" && _kube_clear_cache
  fi
}

function ctxs {
  kubectl config get-contexts
}

function context {
  echo "Select a context:"
  local contexts
  contexts=$(kubectl config get-contexts -o name)
  select ctx_name in $contexts; do
    if [[ -n "$ctx_name" ]]; then
      kubectl config use-context "$ctx_name" && _kube_clear_cache
      break
    fi
  done
}

function cluster {
  local current_ctx server user ns
  current_ctx=$(kubectl config current-context 2>/dev/null)
  server=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)
  user=$(kubectl config view --minify -o jsonpath='{.contexts[0].context.user}' 2>/dev/null)
  ns=$(kubectl config view --minify -o jsonpath='{.contexts[0].context.namespace}' 2>/dev/null)

  echo "Context:   ${current_ctx:-<none>}"
  echo "Server:    ${server:-<unknown>}"
  echo "User:      ${user:-<unknown>}"
  echo "Namespace: ${ns:-default}"
}

#-------------------------------------------------------------------------------
# Core Functions
#-------------------------------------------------------------------------------

function unkube {
  # Unset all functions
  for func in $_KUBE_FUNCTIONS; do
    unset -f "$func" 2>/dev/null
  done

  # Unset variables
  unset KUBEALL _KUBE_CACHE_DIR _KUBE_CACHE_TTL _KUBE_FUNCTIONS
  unset _KUBE_RESOURCE_ACTIONS _KUBE_WATCH_COMMANDS _KUBE_CLUSTER_SCOPED _KUBE_PLURALS

  # Remove completions
  complete -r pod exec logs deployment dep rollout service svc 2>/dev/null
  complete -r ingress ing endpoint ep configmap cm secret certificate cert 2>/dev/null
  complete -r issuer order daemonset statefulset sts job cronjob cj 2>/dev/null
  complete -r replicaset rs persistentvolumeclaim pvc persistentvolume pv 2>/dev/null
  complete -r storageclass networkpolicy netpol serviceaccount sa 2>/dev/null
  complete -r node ns namespace watch kubeall ctx 2>/dev/null

  # Clean up cache
  rm -rf "/tmp/.dank8s-cache-"* 2>/dev/null
}

function kubeall {
  case "$1" in
    "on")
      export KUBEALL="-A"
      echo "All-namespaces mode enabled."
      ;;
    "off")
      export KUBEALL=""
      echo "All-namespaces mode disabled."
      ;;
    "")
      if [ -n "$KUBEALL" ]; then
        echo "All-namespaces mode is ON"
      else
        echo "All-namespaces mode is OFF"
      fi
      ;;
    *)
      echo "Usage: kubeall [on|off]"
      ;;
  esac
}

function pluralize_resource {
  local singular="$1"
  echo "${_KUBE_PLURALS[$singular]:-${singular}s}"
}

function ns {
  kubectl config set-context --current --namespace="$1" && _kube_clear_cache
}

function refresh {
  tput clear
  bash -ic "$@"
}

function khelper {
  local resource
  if [ "${FUNCNAME[1]}" != "exec" ] && [ "${FUNCNAME[1]}" != "logs" ]; then
    resource=$(pluralize_resource "${FUNCNAME[1]}")
    data=$(kubectl get "$resource" -A --no-headers)
  else
    data=$(kubectl get pods -A --no-headers)
  fi
  echo "$(awk -v name="$1" '$2 == name {print $1}' <<< "$data")"
}

#-------------------------------------------------------------------------------
# Watch
#-------------------------------------------------------------------------------

function watch {
  local resource="$1"
  local cmd_template="${_KUBE_WATCH_COMMANDS[$resource]}"

  if [[ -n "$cmd_template" ]]; then
    # Expand KUBEALL variable in command
    CMD=$(eval echo "$cmd_template ${@:2}")
  else
    CMD="$@"
  fi

  stty -echo -icanon
  trap 'stty sane' EXIT INT TERM

  while true; do
    output=$(tput clear; echo "Watching $1 - Press 'q' to quit"; echo; bash -ic "$CMD")
    printf '%s' "$output"

    if read -t 1 -n 1 key; then
      if [[ "$key" == "q" ]]; then
        stty sane
        echo
        break
      fi
    fi
  done

  stty sane
  trap - EXIT INT TERM
}

#-------------------------------------------------------------------------------
# Resource Menu Handler
#-------------------------------------------------------------------------------

function _resource_menu {
  local resource_type="$1"
  local name="$2"
  shift 2
  local extra_args="$@"
  local namespace=""
  local is_cluster_scoped="${_KUBE_CLUSTER_SCOPED[$resource_type]}"

  # Get namespace for namespaced resources
  if [[ -z "$is_cluster_scoped" ]]; then
    local plural=$(pluralize_resource "$resource_type")
    local data=$(kubectl get "$plural" -A --no-headers)
    namespace=$(awk -v name="$name" '$2 == name {print $1}' <<< "$data")
    _kube_require_resource "$resource_type" "$name" "$namespace" || return 1
    kubectl get "$resource_type" -n "${namespace}" "$name" $extra_args
  else
    kubectl get "$resource_type" "$name" $extra_args
  fi

  local actions="${_KUBE_RESOURCE_ACTIONS[$resource_type]}"
  [[ -z "$actions" ]] && return 0

  echo "What would you like to do with this ${resource_type}?"
  select action in $actions; do
    case $action in
      Nothing ) break;;
      Describe )
        if [[ -n "$is_cluster_scoped" ]]; then
          kubectl describe "$resource_type" "$name"
        else
          kubectl describe "$resource_type" -n "${namespace}" "$name"
        fi
        break;;
      YAML )
        if [[ -n "$is_cluster_scoped" ]]; then
          kubectl get "$resource_type" "$name" -o yaml
        else
          kubectl get "$resource_type" -n "${namespace}" "$name" -o yaml
        fi
        break;;
      Edit )
        if [[ -n "$is_cluster_scoped" ]]; then
          kubectl edit "$resource_type" "$name"
        else
          kubectl edit "$resource_type" -n "${namespace}" "$name"
        fi
        break;;
      Delete )
        local extra_warn=""
        [[ "$resource_type" == "namespace" ]] && extra_warn="This will delete ALL resources in the namespace!"
        if _confirm_delete "$resource_type" "$name" "$namespace" "$extra_warn"; then
          if [[ -n "$is_cluster_scoped" ]]; then
            kubectl delete "$resource_type" "$name"
          else
            kubectl delete "$resource_type" -n "${namespace}" "$name"
          fi
        fi
        break;;
      Restart )
        kubectl rollout restart "$resource_type" -n "${namespace}" "$name"
        break;;
      Decode )
        kubectl get secret -n "${namespace}" "$name" -o jsonpath='{.data.*}' | base64 -d
        echo
        break;;
      Recreate )
        if [[ "$resource_type" == "secret" ]]; then
          echo "Are you sure you want to recreate secret $name in namespace $namespace? (yes/no)"
          read confirm
          if [ "$confirm" = "yes" ]; then
            echo "Enter key:"
            read key
            echo "Enter value:"
            read value
            kubectl delete secret -n "${namespace}" "$name"
            kubectl create secret generic "$name" -n "${namespace}" --from-literal="$key"="$value"
          fi
        elif [[ "$resource_type" == "configmap" ]]; then
          echo "Are you sure you want to recreate configmap $name in namespace $namespace? (yes/no)"
          read confirm
          if [ "$confirm" = "yes" ]; then
            echo "Enter path to file:"
            read file
            kubectl create configmap "$name" -n "${namespace}" --from-file="$file" --dry-run=client -o yaml | kubectl apply -f -
          fi
        fi
        break;;
      Suspend )
        kubectl patch cronjob -n "${namespace}" "$name" -p '{"spec":{"suspend":true}}'
        break;;
      Resume )
        kubectl patch cronjob -n "${namespace}" "$name" -p '{"spec":{"suspend":false}}'
        break;;
      Trigger )
        kubectl create job --from=cronjob/"$name" "$name-manual-$(date +%s)" -n "${namespace}"
        break;;
      Logs )
        kubectl logs -n "${namespace}" job/"$name"
        break;;
      Follow )
        kubectl logs -n "${namespace}" "$name" -f $extra_args
        break;;
      Pager )
        kubectl logs -n "${namespace}" "$name" $extra_args --force-colors | less -R
        break;;
    esac
  done
}

