#-------------------------------------------------------------------------------
# Special Actions
#-------------------------------------------------------------------------------

function exec {
  local namespace=$(khelper "$1")
  _kube_require_resource "pod" "$1" "$namespace" || return 1
  if ! kubectl exec -it -n "${namespace}" "$1" -- /bin/bash 2>/dev/null; then
    echo "Falling back to /bin/sh..."
    kubectl exec -it -n "${namespace}" "$1" -- /bin/sh
  fi
}

function rollout {
  local namespace=$(khelper "$1")
  _kube_require_resource "deployment" "$1" "$namespace" || return 1
  kubectl rollout restart deployment -n "${namespace}" "$1"
}

function logs {
  local namespace=$(khelper "$1")
  _kube_require_resource "pod" "$1" "$namespace" || return 1
  kubectl logs -n "${namespace}" "$1" ${@:2}

  echo "What would you like to do with these logs?"
  select action in "Nothing" "Follow" "Pager"; do
    case $action in
      Nothing ) break;;
      Follow ) kubectl logs -n "${namespace}" "$1" -f ${@:2}; break;;
      Pager ) kubectl logs -n "${namespace}" "$1" ${@:2} --force-colors | less -R; break;;
    esac
  done
}

#-------------------------------------------------------------------------------
# Installation Helpers
#-------------------------------------------------------------------------------

function install-nginx {
  local provider="${1:-generic}"

  echo "Installing NGINX Ingress Controller"

  helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx 2>/dev/null
  helm repo update

  case "$provider" in
    azure|aks)
      echo "Using Azure/AKS configuration..."
      helm install ingress-nginx ingress-nginx/ingress-nginx \
        --create-namespace \
        --namespace ingress-nginx \
        --set controller.service.annotations."service\.beta\.kubernetes\.io/azure-load-balancer-health-probe-request-path"=/healthz
      ;;
    *)
      echo "Using generic configuration..."
      helm install ingress-nginx ingress-nginx/ingress-nginx \
        --create-namespace \
        --namespace ingress-nginx
      ;;
  esac

  echo ""
  echo "NGINX Ingress Controller installed. To check status:"
  echo "  kubectl get pods -n ingress-nginx"
}

#-------------------------------------------------------------------------------
# Completions
#-------------------------------------------------------------------------------

_kube_cached_completion() {
  local resource_type="$1"
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local cache_key="completion_${resource_type}"
  local cmd

  case "$resource_type" in
    pods) cmd="kubectl get pods -A --no-headers 2>/dev/null | awk '{print \$2}'" ;;
    deployments) cmd="kubectl get deployments -A --no-headers 2>/dev/null | awk '{print \$2}'" ;;
    services) cmd="kubectl get services -A --no-headers 2>/dev/null | awk '{print \$2}'" ;;
    nodes) cmd="kubectl get nodes --no-headers 2>/dev/null | awk '{print \$1}'" ;;
    namespaces) cmd="kubectl get namespaces --no-headers 2>/dev/null | awk '{print \$1}'" ;;
    contexts) cmd="kubectl config get-contexts -o name 2>/dev/null" ;;
    *) cmd="kubectl get ${resource_type} -A --no-headers 2>/dev/null | awk '{print \$2}'" ;;
  esac

  local resources
  resources=$(_kube_cached_get "$cache_key" "$cmd")
  COMPREPLY=($(compgen -W "${resources}" -- "${cur}"))
}

_kube_pod_completion() { _kube_cached_completion pods; }
_kube_deployment_completion() { _kube_cached_completion deployments; }
_kube_service_completion() { _kube_cached_completion services; }
_kube_node_completion() { _kube_cached_completion nodes; }
_kube_namespace_completion() { _kube_cached_completion namespaces; }
_kube_context_completion() { _kube_cached_completion contexts; }

_kube_resource_completion() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local func_name="${FUNCNAME[1]}"
  local resource_type

  # Map function to resource type
  case "$func_name" in
    _kube_*_completion) resource_type="${func_name#_kube_}"; resource_type="${resource_type%_completion}" ;;
    *) resource_type="$1" ;;
  esac

  # Pluralize
  local plural="${_KUBE_PLURALS[$resource_type]:-${resource_type}s}"
  _kube_cached_completion "$plural"
}

_kube_watch_completion() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local resources="pods deployments services nodes events ingresses endpoints configmaps secrets certificates issuers orders daemonsets statefulsets jobs cronjobs replicasets persistentvolumeclaims persistentvolumes storageclasses networkpolicies serviceaccounts namespaces"
  COMPREPLY=($(compgen -W "${resources}" -- "${cur}"))
}

_kube_kubeall_completion() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=($(compgen -W "on off" -- "${cur}"))
}

# Register completions
complete -F _kube_pod_completion pod exec logs
complete -F _kube_deployment_completion deployment dep rollout
complete -F _kube_service_completion service svc
complete -F _kube_resource_completion ingress ing endpoint ep configmap cm secret certificate cert issuer order daemonset statefulset sts job cronjob cj replicaset rs persistentvolumeclaim pvc
complete -F _kube_node_completion node persistentvolume pv
complete -F _kube_namespace_completion ns namespace
complete -F _kube_context_completion ctx
complete -F _kube_watch_completion watch
complete -F _kube_kubeall_completion kubeall
complete -F _kube_resource_completion storageclass networkpolicy netpol serviceaccount sa

